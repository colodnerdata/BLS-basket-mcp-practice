* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
uv.lock text eol=lf
*.png binary
*.jpg binary
*.pdf binary
*.xlsx binary

# Byte-exact records: hashes and sizes of these files are recorded in
# data/manifest.json (docs/DECISIONS.md, 2026-10-10), so line endings must
# never be normalized on commit or checkout.
docs/sample_data/** -text
tests/fixtures/** -text
